# Copy this file to `.env` (which is git-ignored) and fill in the key.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# Never commit `.env`. Never paste the key into chat, issues, or slides.

# anthropic = call Claude; none = rule-based parser only (no network, no cost)
DESK_LLM_PROVIDER=anthropic

# Cheapest current Claude model; enough for field extraction.
DESK_LLM_MODEL=claude-haiku-4-5

# From console.anthropic.com -> API Keys. One key per person is best; revoke it if leaked.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Hard stop per Python process, in USD. The console spend limit is the real safety net.
DESK_LLM_BUDGET_USD=2
