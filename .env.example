# Copy this file to `.env` (which is git-ignored) and fill in the key.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# Never commit `.env`. Never paste the key into chat, issues, or slides.

# openai = call GPT-5 nano; none = rule-based parser only (no network, no cost)
DESK_LLM_PROVIDER=openai

# Cheapest GPT-5 model; enough for field extraction.
DESK_LLM_MODEL=gpt-5-nano

# From platform.openai.com -> API keys. A ChatGPT subscription does not include API access.
OPENAI_API_KEY=sk-REPLACE-ME

# Hard stop per Python process, in USD. The project spend limit on the OpenAI dashboard is the real safety net.
DESK_LLM_BUDGET_USD=2

# Reasoning effort for GPT-5 models. low is enough for extraction; leave empty to use the model default.
DESK_LLM_REASONING_EFFORT=low
